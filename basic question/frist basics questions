let a = 0, b = 1;
for(let i=1;i<=n;i++){
  console.log(a);
  let c = a + b;
  a = b;
  b = c;
}

Output:
0 1 1 2 3
"""),

("21. Armstrong Number Check",
"""Example:
let n = 153;
let t = n, sum = 0;
while(t > 0){
  let d = t % 10;
  sum += d*d*d;
  t = Math.floor(t/10);
}
console.log(sum === n);

Output:
true
"""),

("22. Count Even and Odd Digits",
"""Example:
let n = 12345;
let even = 0, odd = 0;
while(n > 0){
  let d = n % 10;
  d % 2 === 0 ? even++ : odd++;
  n = Math.floor(n/10);
}
console.log(even, odd);

Output:
2 3
"""),

